# ==============================================================================
# G-DMAD Framework Configuration (.env.example)
# Copy this file to '.env' and fill in the values for your preferred provider.
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: ExperientialLabs AI (Recommended / Current Default)
# ------------------------------------------------------------------------------
EXPERIENTIALLABS_API_KEY=your_experientiallabs_api_key_here
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
USE_MOCK_LLM=false
MODEL_NAME=gpt-4o-mini
API_BASE=https://api.experientiallabs.ai/v1

# ------------------------------------------------------------------------------
# OPTION 2: Official OpenAI
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=sk-proj-your_openai_api_key_here
# USE_MOCK_LLM=false
# MODEL_NAME=gpt-4o-mini
# API_BASE=

# ------------------------------------------------------------------------------
# OPTION 3: Groq (Fast Inference)
# ------------------------------------------------------------------------------
# GROQ_API_KEY=gsk_your_groq_api_key_here
# USE_MOCK_LLM=false
# MODEL_NAME=llama-3.1-8b-instant
# API_BASE=https://api.groq.com/openai/v1

# ------------------------------------------------------------------------------
# OPTION 4: OpenRouter
# ------------------------------------------------------------------------------
# OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
# USE_MOCK_LLM=false
# MODEL_NAME=meta-llama/llama-3.1-8b-instruct:free
# API_BASE=https://openrouter.ai/api/v1

# ------------------------------------------------------------------------------
# OPTION 5: Offline Mock Mode (No API Key Required / Free Testing)
# ------------------------------------------------------------------------------
# USE_MOCK_LLM=true
# MODEL_NAME=mock-llm
# API_BASE=

# ------------------------------------------------------------------------------
# Debate System Hyperparameters
# ------------------------------------------------------------------------------
TEMPERATURE=0.3
ROUNDS=3
GROUPS=2
AGENTS_PER_GROUP=3
MAX_TOKENS=2048
API_TYPE=
API_VERSION=
